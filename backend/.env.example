APP_NAME=Nikosh
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://nikosh:nikosh@localhost:5432/nikosh
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=480
COOKIE_SECURE=false
TESSERACT_CMD=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL=
GOOGLE_SHEET_ID=
GOOGLE_FORM_PREFILL_URL=
BLOGGER_BLOG_ID=
# Base URL of the frontend in emailed join links (set to the tunnel URL for two-PC tests)
FRONTEND_BASE_URL=http://localhost:3000
# Address of the authorized Google account (organizer of calendar invites)
GOOGLE_ACCOUNT_EMAIL=
# Speech-to-text: deepgram | stub (whisper planned)
TRANSCRIBER=stub
# Deepgram API key (secret, never commit)
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
# Log transcript text (testing only)
TRANSCRIPT_LOG_TEXT=false
# Scheduling assistant: working days and office hours (Asia/Dhaka)
WORKING_DAYS=mon,tue,wed,thu,fri
OFFICE_START=09:00
OFFICE_END=18:00

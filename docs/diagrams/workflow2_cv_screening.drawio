<mxfile host="app.diagrams.net"><diagram id="workflow2" name="Workflow 2"><mxGraphModel dx="1500" dy="1330" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1330" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Nikosh · Workflow 2 — CV Intake, Screening &amp; Ranking" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="36" as="geometry"/></mxCell><mxCell id="lane0" value="A.  CV Intake  (on Sync / Upload)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="56" width="720" height="1260" as="geometry"/></mxCell><mxCell id="lane1" value="B.  LangGraph CV Screening Workflow  (on Process CVs)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="760" y="56" width="720" height="1260" as="geometry"/></mxCell><mxCell id="a_form" value="Applicant submits the job&#x27;s own&lt;br&gt;Google Form (name, email, phone, CV)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#111827;fontSize=12;" vertex="1" parent="1"><mxGeometry x="150.0" y="82" width="300" height="52" as="geometry"/></mxCell><mxCell id="a_sync" value="Sync new responses&lt;br&gt;(MCP: list_job_applications)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#111827;fontSize=12;" vertex="1" parent="1"><mxGeometry x="160.0" y="162" width="280" height="52" as="geometry"/></mxCell><mxCell id="d_late" value="Submitted after&lt;br&gt;the deadline?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F9FAFB;strokeColor=#374151;fontColor=#111827;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200.0" y="240.0" width="200" height="90" as="geometry"/></mxCell><mxCell id="d_dup" value="Email already&lt;br&gt;applied to this job?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F9FAFB;strokeColor=#374151;fontColor=#111827;fontSize=12;" vertex="1" parent="1"><mxGeometry x="195.0" y="355.0" width="210" height="90" as="geometry"/></mxCell><mxCell id="a_dl" value="Download CV from Drive&lt;br&gt;(MCP: download_cv)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#111827;fontSize=12;" vertex="1" parent="1"><mxGeometry x="160.0" y="476" width="280" height="52" as="geometry"/></mxCell><mxCell id="d_valid" value="PDF / DOCX&lt;br&gt;and ≤ 10 MB?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F9FAFB;strokeColor=#374151;fontColor=#111827;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200.0" y="560.0" width="200" height="90" as="geometry"/></mxCell><mxCell id="a_upload" value="Interviewer&lt;br&gt;uploads CVs&lt;br&gt;(batch)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#111827;fontSize=12;" vertex="1" parent="1"><mxGeometry x="32" y="570" width="120" height="70" as="geometry"/></mxCell><mxCell id="d_hash" value="Same CV already&lt;br&gt;submitted (SHA-256)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F9FAFB;strokeColor=#374151;fontColor=#111827;fontSize=12;" vertex="1" parent="1"><mxGeometry x="190.0" y="675.0" width="220" height="90" as="geometry"/></mxCell><mxCell id="a_store" value="Store CV file + save candidate&lt;br&gt;(status: applied)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4B5563;fontColor=#111827;fontSize=12;" vertex="1" parent="1"><mxGeometry x="150.0" y="796" width="300" height="52" as="geometry"/></mxCell><mxCell id="a_extract" value="Extract text&lt;br&gt;(pypdf / python-docx, OCR fallback)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#111827;fontSize=12;" vertex="1" parent="1"><mxGeometry x="150.0" y="878" width="300" height="52" as="geometry"/></mxCell><mxCell id="a_parse" value="Parse structured profile (Gemini)&lt;br&gt;experience years calculated in code" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#111827;fontSize=12;" vertex="1" parent="1"><mxGeometry x="150.0" y="960" width="300" height="52" as="geometry"/></mxCell><mxCell id="a_rej" value="Rejected&lt;br&gt;(reason saved,&lt;br&gt;CV not stored)&lt;br&gt;&lt;br&gt;• late application&lt;br&gt;• duplicate email&lt;br&gt;• invalid file&lt;br&gt;• duplicate CV" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#111827;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="500" y="255" width="190" height="510" as="geometry"/></mxCell><mxCell id="a_note" value="Intake is deterministic service code (not LangGraph).&lt;br&gt;Every success and failure is logged." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;fontColor=#111827;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="1045" width="660" height="48" as="geometry"/></mxCell><mxCell id="b_click" value="Process CVs → POST /jobs/{id}/screening&lt;br&gt;ScreeningRun created · runs in the background" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#111827;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880.0" y="82" width="360" height="52" as="geometry"/></mxCell><mxCell id="b_START" value="START" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F2937;strokeColor=#1F2937;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1005.0" y="158" width="110" height="34" as="geometry"/></mxCell><mxCell id="b_load" value="load_candidates&lt;br&gt;applied + not yet screened → run.total" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4B5563;fontColor=#111827;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900.0" y="216" width="320" height="52" as="geometry"/></mxCell><mxCell id="d_any" value="Any CVs&lt;br&gt;to screen?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F9FAFB;strokeColor=#374151;fontColor=#111827;fontSize=12;" vertex="1" parent="1"><mxGeometry x="970.0" y="303.0" width="180" height="84" as="geometry"/></mxCell><mxCell id="b_send" value="dispatch: Send() one branch per CV&lt;br&gt;(max 3 in parallel)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4B5563;fontColor=#111827;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900.0" y="414" width="320" height="52" as="geometry"/></mxCell><mxCell id="g_screen" value="screen_cv  (per CV, parallel)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#94A3B8;fontColor=#111827;fontSize=12;fontStyle=1;dashed=1;fillColor=none;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="800" y="492" width="650" height="610" as="geometry"/></mxCell><mxCell id="b_prep" value="Prepare CV&lt;br&gt;extract text / parse profile if missing" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#111827;fontSize=12;" vertex="1" parent="1"><mxGeometry x="910.0" y="530" width="300" height="52" as="geometry"/></mxCell><mxCell id="b_match" value="match_cv (Gemini)&lt;br&gt;Met / Partially Met / Unmet + evidence" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#111827;fontSize=12;" vertex="1" parent="1"><mxGeometry x="910.0" y="610" width="300" height="52" as="geometry"/></mxCell><mxCell id="b_exp" value="Experience rule (code)&lt;br&gt;years from job dates vs required" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#111827;fontSize=12;" vertex="1" parent="1"><mxGeometry x="910.0" y="690" width="300" height="52" as="geometry"/></mxCell><mxCell id="b_score" value="Weighted match score (code)&lt;br&gt;met 1 · partial 0.5 · unmet 0  →  0–100" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#111827;fontSize=12;" vertex="1" parent="1"><mxGeometry x="910.0" y="770" width="300" height="52" as="geometry"/></mxCell><mxCell id="d_mand" value="Mandatory&lt;br&gt;requirement unmet?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F9FAFB;strokeColor=#374151;fontColor=#111827;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960.0" y="843.0" width="200" height="84" as="geometry"/></mxCell><mxCell id="b_excl" value="Excluded&lt;br&gt;reason: missing mandatory&lt;br&gt;requirement (not ranked)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;fontColor=#111827;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1240" y="857" width="190" height="58" as="geometry"/></mxCell><mxCell id="b_elig" value="Eligible (status: applied)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#111827;fontSize=12;" vertex="1" parent="1"><mxGeometry x="930.0" y="958" width="260" height="40" as="geometry"/></mxCell><mxCell id="b_prog" value="Progress: run.processed + 1&lt;br&gt;(succeeded / failed)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4B5563;fontColor=#111827;fontSize=12;" vertex="1" parent="1"><mxGeometry x="930.0" y="1030" width="260" height="50" as="geometry"/></mxCell><mxCell id="b_fail" value="On error:&lt;br&gt;CV marked failed&lt;br&gt;(error saved, other&lt;br&gt;CVs continue)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#111827;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1230" y="520" width="200" height="150" as="geometry"/></mxCell><mxCell id="b_final" value="finalize&lt;br&gt;run completed · finished_at saved" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4B5563;fontColor=#111827;fontSize=12;" vertex="1" parent="1"><mxGeometry x="910.0" y="1128" width="300" height="52" as="geometry"/></mxCell><mxCell id="b_END" value="END" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F2937;strokeColor=#1F2937;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1005.0" y="1206" width="110" height="34" as="geometry"/></mxCell><mxCell id="b_rank" value="Ranked list: eligible by score ↓&lt;br&gt;Applicants · Excluded · Rejected tabs" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#111827;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1210" y="1128" width="240" height="52" as="geometry"/></mxCell><mxCell id="b_note" value="State checkpointed in PostgreSQL (thread screening-run-{id}) · UI polls progress every 2 s ·&lt;br&gt;runs interrupted by a restart are marked failed; Process CVs again continues with unscreened CVs" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;fontColor=#111827;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="800" y="1258" width="650" height="48" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#374151;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_form" target="a_sync"><mxGeometry x="-0.5" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#374151;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_sync" target="d_late"><mxGeometry x="-0.5" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="No" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#374151;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="d_late" target="d_dup"><mxGeometry x="-0.5" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="No" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#374151;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="d_dup" target="a_dl"><mxGeometry x="-0.5" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#374151;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_dl" target="d_valid"><mxGeometry x="-0.5" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#374151;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_upload" target="d_valid"><mxGeometry x="-0.5" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="Yes" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#374151;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="d_valid" target="d_hash"><mxGeometry x="-0.5" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="No" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill
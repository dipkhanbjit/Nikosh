<mxfile host="drawio"><diagram name="Workflow 1"><mxGraphModel grid="0" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Workflow 1 — JD Generation &amp;amp; Posting&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=28;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="700" height="50" as="geometry"/></mxCell><mxCell id="start" value="START" style="ellipse;whiteSpace=wrap;html=1;fillColor=#263238;strokeColor=#263238;fontColor=#FFFFFF;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="335" y="100" width="170" height="60" as="geometry"/></mxCell><mxCell id="retrieve" value="&lt;b&gt;&lt;font face='Courier New' style='font-size:17px'&gt;retrieve&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#444444'&gt;vector search: role query (k=5) + company &amp;amp; benefits query (k=3), deduplicated&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="270" y="220" width="300" height="80" as="geometry"/></mxCell><mxCell id="draft" value="&lt;b&gt;&lt;font face='Courier New' style='font-size:17px'&gt;draft&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#444444'&gt;Gemini structured output: Markdown JD + requirements&lt;br&gt;(category, mandatory, weight 1–5)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="270" y="370" width="300" height="90" as="geometry"/></mxCell><mxCell id="review" value="&lt;b&gt;&lt;font face='Courier New' style='font-size:17px'&gt;review&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#444444'&gt;interrupt: interviewer approves (optional manual edits) or refines with feedback&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="270" y="540" width="300" height="90" as="geometry"/></mxCell><mxCell id="save" value="&lt;b&gt;&lt;font face='Courier New' style='font-size:17px'&gt;save&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#444444'&gt;write JD + requirements to job, status = approved&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="270" y="720" width="300" height="75" as="geometry"/></mxCell><mxCell id="post" value="&lt;b&gt;&lt;font face='Courier New' style='font-size:17px'&gt;post_jd&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#444444'&gt;publish_job() via MCP client:&lt;br&gt;1. publish_to_blogger (full JD + Form apply link)&lt;br&gt;2. publish_to_telegram (announcement + JD &amp;amp; apply links)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="270" y="880" width="300" height="100" as="geometry"/></mxCell><mxCell id="end" value="END" style="ellipse;whiteSpace=wrap;html=1;fillColor=#263238;strokeColor=#263238;fontColor=#FFFFFF;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="335" y="1080" width="170" height="60" as="geometry"/></mxCell><mxCell id="mcp" value="&lt;b&gt;&lt;font face='Courier New' style='font-size:15px'&gt;nikosh-tools&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;MCP server (stdio)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;• publish_to_blogger → Blogger API v3&lt;br&gt;• publish_to_telegram → Telegram Bot API&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;spacingLeft=10;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="-200" y="875" width="260" height="110" as="geometry"/></mxCell><mxCell id="e1" value="job profile + recruiter prompt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#000000;" edge="1" parent="1" source="start" target="retrieve"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="RAG context" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#000000;" edge="1" parent="1" source="retrieve" target="draft"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="JD draft + requirements" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#000000;" edge="1" parent="1" source="draft" target="review"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="refine (feedback + previous draft)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=1;strokeColor=#B85450;fontColor=#B85450;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="review" target="draft"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="680" y="585"/><mxPoint x="680" y="415"/></Array></mxGeometry></mxCell><mxCell id="e5" value="approve (+ optional manual edits)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=1;strokeColor=#B85450;fontColor=#B85450;" edge="1" parent="1" source="review" target="save"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="approved JD" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#000000;" edge="1" parent="1" source="save" target="post"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="emcp" value="MCP tool calls" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=1;strokeColor=#D6B656;fontColor=#7F6000;exitX=0;exitY=0.5;entryX=1;entryY=0.5;startArrow=block;startFill=1;" edge="1" parent="1" source="post" target="mcp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="Blogger posted: status = posted&lt;br&gt;(Telegram result stored separately)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=1;strokeColor=#B85450;fontColor=#B85450;" edge="1" parent="1" source="post" target="end"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="Blogger failed: error stored,&lt;br&gt;status stays approved" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=1;strokeColor=#B85450;fontColor=#B85450;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="post" target="end"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="680" y="930"/><mxPoint x="680" y="1110"/></Array></mxGeometry></mxCell><mxCell id="lgt" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;" vertex="1" parent="1"><mxGeometry x="830" y="110" width="200" height="30" as="geometry"/></mxCell><mxCell id="lg0" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="830" y="155" width="60" height="32" as="geometry"/></mxCell><mxCell id="lgl0" value="LLM node" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="905" y="155" width="230" height="32" as="geometry"/></mxCell><mxCell id="lg1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="830" y="205" width="60" height="32" as="geometry"/></mxCell><mxCell id="lgl1" value="Regular node (no LLM)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="905" y="205" width="230" height="32" as="geometry"/></mxCell><mxCell id="lg2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="830" y="255" width="60" height="32" as="geometry"/></mxCell><mxCell id="lgl2" value="Tool / external call" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="905" y="255" width="230" height="32" as="geometry"/></mxCell><mxCell id="lg3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="830" y="305" width="60" height="32" as="geometry"/></mxCell><mxCell id="lgl3" value="Human-in-the-loop (interrupt)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="905" y="305" width="230" height="32" as="geometry"/></mxCell><mxCell id="lg4" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="830" y="355" width="60" height="32" as="geometry"/></mxCell><mxCell id="lgl4" value="MCP server" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="905" y="355" width="230" height="32" as="geometry"/></mxCell><mxCell id="le0" value="" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="431" as="sourcePoint"/><mxPoint x="890" y="431" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lel0" value="normal edge" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="905" y="415" width="230" height="32" as="geometry"/></mxCell><mxCell id="le1" value="" style="endArrow=none;html=1;strokeWidth=2;dashed=1;strokeColor=#B85450;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="471" as="sourcePoint"/><mxPoint x="890" y="471" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lel1" value="conditional edge" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontColor=#B85450;" vertex="1" parent="1"><mxGeometry x="905" y="455" width="230" height="32" as="geometry"/></mxCell><mxCell id="note" value="&lt;b&gt;State:&lt;/b&gt; checkpointed in PostgreSQL (thread &lt;font face='Courier New'&gt;jd-job-{id}&lt;/font&gt;), so the workflow resumes after a restart or page refresh.&lt;br&gt;&lt;br&gt;&lt;b&gt;Endpoints:&lt;/b&gt; generate starts the run; review resumes the interrupt; GET returns the current state.&lt;br&gt;&lt;br&gt;&lt;b&gt;Retry:&lt;/b&gt; POST /jobs/{id}/post calls the same publish_job() outside the graph and re-posts only the platform that failed.&lt;br&gt;&lt;br&gt;&lt;b&gt;Lock:&lt;/b&gt; posted JDs cannot be revised." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;strokeColor=#999999;fillColor=#FAFAFA;rounded=1;spacing=10;" vertex="1" parent="1"><mxGeometry x="830" y="515" width="340" height="250" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>